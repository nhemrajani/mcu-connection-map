# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node / frontend
node_modules/
dist/
.next/
build/

# Model + data caches
*.safetensors
*.ckpt
.cache/

# Wikipedia text cache - regenerate with ingest/plots.py
plots/

# Pipeline output.
# ml/out/ is generated, but graph.json is what the canvas actually loads, so
# it has to be committed for the site to deploy. The big binaries and the
# review scratch files stay out.
ml/out/*
!ml/out/graph.json
!ml/out/candidates.json
!ml/out/proposed_edges.json
!ml/out/reference_edges.json

# OS / editor
.DS_Store
.vscode/
.idea/
*.log

# Generated art: regenerate with art/style.py, keep the sheet only
art/sheet/
art/_smoke.png
art/one.png
art/world/
art/world-test.png
art/terrain-ink-*.png
